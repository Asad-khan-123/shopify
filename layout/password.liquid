<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <style>
    :root {
      --color-cream: #F8F4EE; --color-ivory: #F2EDE5; --color-warm-white: #FDFAF6;
      --color-sand: #E8DFD2; --color-tan: #C9B99A; --color-charcoal: #2A2520;
      --color-muted-brown: #6B5D52; --color-accent-gold: #C4A882; --color-accent-rust: #9B6E4E;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Jost', sans-serif;
    }
    body { font-family: var(--font-sans); background: var(--color-warm-white); color: var(--color-charcoal); font-weight: 300; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .password-wrap { text-align: center; padding: 60px 40px; max-width: 480px; width: 100%; }
    .password-logo { font-family: var(--font-serif); font-size: 36px; letter-spacing: 8px; text-transform: uppercase; margin-bottom: 32px; color: var(--color-charcoal); }
    .password-heading { font-family: var(--font-serif); font-size: 28px; font-weight: 300; margin-bottom: 16px; }
    .password-subtext { font-size: 14px; color: var(--color-muted-brown); line-height: 1.8; margin-bottom: 40px; }
    .password-form { display: flex; gap: 0; max-width: 340px; margin: 0 auto; }
    .password-input { flex: 1; padding: 14px 16px; border: 1px solid var(--color-sand); border-right: none; background: white; font-family: var(--font-sans); font-size: 13px; outline: none; }
    .password-input:focus { border-color: var(--color-tan); }
    .password-btn { padding: 14px 24px; background: var(--color-charcoal); color: var(--color-cream); border: 1px solid var(--color-charcoal); font-family: var(--font-sans); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; }
    .password-btn:hover { background: var(--color-accent-rust); border-color: var(--color-accent-rust); }
    .password-error { color: var(--color-accent-rust); font-size: 12px; margin-top: 12px; }
  </style>
</head>
<body>
  <div class="password-wrap">
    <div class="password-logo">{{ shop.name }}</div>
    <h1 class="password-heading">{{ 'general.password_page.login_form_heading' | t }}</h1>
    <p class="password-subtext">{{ 'general.password_page.login_form_subtext' | t }}</p>
    {{ content_for_layout }}
  </div>
</body>
</html>
