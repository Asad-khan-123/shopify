<div class="password-section">
  <div class="password-inner">
    <div class="password-logo">{{ shop.name }}</div>

    {%- if section.settings.eyebrow != blank -%}
      <p class="password-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="password-heading">{{ section.settings.heading }}</h1>

    {%- if section.settings.subtext != blank -%}
      <p class="password-subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- form 'storefront_password', id: 'login' -%}
      {%- if form.errors -%}
        <div class="form-error password-error" role="alert">{{ 'general.password_page.login_form_error' | t }}</div>
      {%- endif -%}
      <div class="password-form">
        <input
          type="password"
          name="password"
          id="Password"
          class="password-input"
          placeholder="{{ section.settings.password_placeholder | default: 'Password' }}"
          autocomplete="current-password"
          required
        >
        <button type="submit" class="password-btn">{{ section.settings.submit_label | default: 'Enter' }}</button>
      </div>
    {%- endform -%}

    {%- if section.settings.notify_heading != blank -%}
      <div class="password-notify">
        <p class="password-notify-heading">{{ section.settings.notify_heading }}</p>
        {%- form 'customer' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success">{{ section.settings.notify_success }}</p>
          {%- else -%}
            <div class="password-form">
              <input type="email" name="contact[email]" class="password-input" placeholder="{{ section.settings.notify_placeholder }}" required>
              <button type="submit" class="password-btn">{{ section.settings.notify_btn }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .password-section { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 60px 40px; background: var(--warm-white); }
  .password-inner { max-width: 480px; width: 100%; text-align: center; }
  .password-logo { font-family: var(--font-serif); font-size: 36px; letter-spacing: 8px; text-transform: uppercase; color: var(--charcoal); margin-bottom: 40px; }
  .password-eyebrow { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: var(--accent-gold); margin-bottom: 16px; }
  .password-heading { font-family: var(--font-serif); font-size: clamp(28px, 4vw, 44px); font-weight: 300; color: var(--charcoal); margin-bottom: 16px; line-height: 1.1; }
  .password-subtext { font-size: 15px; color: var(--muted-brown); line-height: 1.8; margin-bottom: 40px; }
  .password-form { display: flex; max-width: 360px; margin: 0 auto; }
  .password-input { flex: 1; padding: 14px 16px; border: 1px solid var(--sand); border-right: none; background: transparent; font-family: var(--font-sans); font-size: 13px; color: var(--charcoal); outline: none; }
  .password-input:focus { border-color: var(--accent-gold); }
  .password-input::placeholder { color: var(--tan); }
  .password-btn { padding: 14px 24px; background: var(--charcoal); color: var(--cream); border: 1px solid var(--charcoal); font-family: var(--font-sans); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
  .password-btn:hover { background: var(--accent-rust); border-color: var(--accent-rust); }
  .password-error { color: var(--accent-rust); font-size: 12px; margin-bottom: 16px; }
  .password-notify { margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--sand); }
  .password-notify-heading { font-size: 13px; color: var(--muted-brown); margin-bottom: 20px; }
</style>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "password_placeholder", "label": "Password Placeholder" },
    { "type": "text", "id": "submit_label", "label": "Submit Button Label" },
    { "type": "header", "content": "Notify Section" },
    { "type": "text", "id": "notify_heading", "label": "Notify Heading" },
    { "type": "text", "id": "notify_placeholder", "label": "Email Placeholder" },
    { "type": "text", "id": "notify_btn", "label": "Notify Button Label" },
    { "type": "text", "id": "notify_success", "label": "Success Message" }
  ]
}
{% endschema %}
