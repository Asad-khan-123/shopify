<section class="search-section">
  <div class="search-inner">
    <div class="search-hero">
      {%- if section.settings.heading != blank -%}
        <h1 class="search-hero-title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      <form action="{{ routes.search_url }}" method="get" class="search-page-form" role="search">
        <input type="hidden" name="type" value="{{ section.settings.search_type | default: 'product' }}">
        <div class="search-page-input-group">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.placeholder }}"
            class="search-page-input"
            autocomplete="off"
            id="search-page-input-{{ section.id }}"
            aria-label="{{ section.settings.placeholder }}"
          >
          <button type="submit" class="search-page-btn" aria-label="{{ 'general.search.search' | t }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="search-no-results">
          <p class="search-no-results-text">
            {{ 'general.search.no_results_html' | t: terms: search.terms }}
          </p>
          {%- if section.settings.no_results_suggestion != blank -%}
            <p class="search-suggestion">{{ section.settings.no_results_suggestion }}</p>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="search-results-header">
          <p class="search-results-count">
            {{ 'general.search.results_count' | t: terms: search.terms, count: search.results_count }}
          </p>
        </div>
        <div class="products-grid search-results-grid">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {%- render 'card-product', card_product: result, show_quick_add: true, section_id: section.id -%}
            {%- elsif result.object_type == 'article' -%}
              <article class="search-article-card">
                {%- if result.image != blank -%}
                  <a href="{{ result.url }}">
                    <img src="{{ result.image | image_url: width: 400 }}" alt="{{ result.image.alt | escape }}" class="search-article-img" width="400" height="300" loading="lazy">
                  </a>
                {%- endif -%}
                <div class="search-article-info">
                  <p class="search-article-type">{{ 'blogs.article.type' | t }}</p>
                  <h3 class="search-article-title"><a href="{{ result.url }}">{{ result.title | escape }}</a></h3>
                  <p class="search-article-excerpt">{{ result.content | strip_html | truncatewords: 20 }}</p>
                </div>
              </article>
            {%- elsif result.object_type == 'page' -%}
              <div class="search-page-card">
                <p class="search-article-type">{{ 'pages.page.type' | t }}</p>
                <h3 class="search-article-title"><a href="{{ result.url }}">{{ result.title | escape }}</a></h3>
                <p class="search-article-excerpt">{{ result.content | strip_html | truncatewords: 20 }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if search.results.size < search.results_count -%}
          {%- paginate search.results by section.settings.results_per_page -%}
            {%- if paginate.pages > 1 -%}
              <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="pagination-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
                  </a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="pagination-num">{{ part.title }}</a>
                  {%- else -%}
                    <span class="pagination-num {% if part.title == paginate.current_page %}active{% endif %}">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="pagination-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
                  </a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endpaginate -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .search-section { padding: 60px 40px 100px; min-height: 60vh; }
  .search-inner { max-width: var(--layout-max-width); margin: 0 auto; }
  .search-hero { text-align: center; padding: 60px 0 60px; border-bottom: 1px solid var(--sand); margin-bottom: 60px; }
  .search-hero-title { font-family: var(--font-serif); font-size: clamp(32px, 4vw, 52px); font-weight: 300; color: var(--charcoal); margin-bottom: 32px; }
  .search-page-form { max-width: 640px; margin: 0 auto; }
  .search-page-input-group { display: flex; border: 1px solid var(--sand); transition: border-color 0.2s; }
  .search-page-input-group:focus-within { border-color: var(--charcoal); }
  .search-page-input { flex: 1; background: transparent; border: none; padding: 16px 20px; font-size: 15px; color: var(--charcoal); font-family: var(--font-sans); outline: none; }
  .search-page-input::placeholder { color: var(--tan); }
  .search-page-btn { background: var(--charcoal); border: none; padding: 16px 24px; cursor: pointer; color: var(--cream); display: flex; align-items: center; transition: background 0.2s; }
  .search-page-btn:hover { background: var(--accent-rust); }
  .search-results-header { margin-bottom: 32px; }
  .search-results-count { font-size: 13px; color: var(--muted-brown); letter-spacing: 0.5px; }
  .search-results-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .search-no-results { text-align: center; padding: 80px 20px; }
  .search-no-results-text { font-family: var(--font-serif); font-size: 24px; color: var(--charcoal); margin-bottom: 16px; }
  .search-suggestion { font-size: 14px; color: var(--muted-brown); }
  .search-article-card, .search-page-card { border: 1px solid var(--sand); overflow: hidden; }
  .search-article-img { width: 100%; height: 200px; object-fit: cover; display: block; }
  .search-article-info { padding: 20px; }
  .search-article-type { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--accent-gold); margin-bottom: 8px; }
  .search-article-title { font-family: var(--font-serif); font-size: 20px; font-weight: 400; margin-bottom: 8px; }
  .search-article-title a { color: var(--charcoal); text-decoration: none; }
  .search-article-title a:hover { color: var(--accent-rust); }
  .search-article-excerpt { font-size: 13px; color: var(--muted-brown); line-height: 1.7; }
  @media (max-width: 1024px) { .search-results-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) {
    .search-section { padding: 40px 20px 60px; }
    .search-results-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (max-width: 480px) { .search-results-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Search Page Heading"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search Input Placeholder"
    },
    {
      "type": "select",
      "id": "search_type",
      "label": "Search Type",
      "options": [
        { "value": "product", "label": "Products Only" },
        { "value": "product,article,page", "label": "Products, Articles & Pages" }
      ],
      "default": "product"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results Per Page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "textarea",
      "id": "no_results_suggestion",
      "label": "No Results Suggestion Text"
    }
  ],
  "presets": [
    {
      "name": "Search"
    }
  ]
}
{% endschema %}
