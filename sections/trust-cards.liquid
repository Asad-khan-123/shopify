<section class="trust-cards" style="background: {{ section.settings.bg_color }}; border-top: 1px solid var(--sand); border-bottom: 1px solid var(--sand);">
  <div class="trust-cards__inner">
    <div class="trust-cards-grid" style="--cols: {{ section.blocks | where: 'type', 'trust_card' | size }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_card' -%}
          <div class="trust-card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_emoji != blank -%}
              <div class="trust-card-icon">{{ block.settings.icon_emoji }}</div>
            {%- elsif block.settings.icon_image != blank -%}
              <div class="trust-card-icon">
                <img src="{{ block.settings.icon_image | image_url: width: 80 }}" alt="" width="60" height="60" loading="lazy">
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="trust-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="trust-card-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .trust-cards { padding: 80px 40px; }
  .trust-cards__inner { max-width: var(--layout-max-width); margin: 0 auto; }
  .trust-cards-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 40px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .trust-card { text-align: center; }
  .trust-card-icon { width: 60px; height: 60px; margin: 0 auto 24px; display: flex; align-items: center; justify-content: center; font-size: 32px; }
  .trust-card-title { font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: var(--charcoal); margin-bottom: 12px; letter-spacing: 0.5px; }
  .trust-card-desc { font-size: 13px; color: var(--muted-brown); line-height: 1.8; letter-spacing: 0.3px; }
  @media (max-width: 768px) {
    .trust-cards { padding: 60px 20px; }
    .trust-cards-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

{% schema %}
{
  "name": "Trust Cards",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFAF6"
    }
  ],
  "blocks": [
    {
      "type": "trust_card",
      "name": "Trust Card",
      "settings": [
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon Emoji"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Cards",
      "blocks": [
        { "type": "trust_card" },
        { "type": "trust_card" },
        { "type": "trust_card" }
      ]
    }
  ]
}
{% endschema %}
