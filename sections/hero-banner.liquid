<section class="hero-section">
  <div class="hero-right" style="
    {%- if section.settings.bg_image != blank -%}
      background-image: url('{{ section.settings.bg_image | image_url: width: 1800 }}');
      background-size: cover;
      background-position: center;
    {%- else -%}
      background-color: {{ section.settings.bg_color }};
    {%- endif -%}
  ">
    {%- if section.settings.bg_image != blank -%}
      <div class="hero-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}

    <div class="hero-content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hero-cta-group">
        {%- if section.settings.btn_primary_label != blank and section.settings.btn_primary_url != blank -%}
          <a href="{{ section.settings.btn_primary_url }}" class="btn-primary">{{ section.settings.btn_primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn_ghost_label != blank and section.settings.btn_ghost_url != blank -%}
          <a href="{{ section.settings.btn_ghost_url }}" class="btn-ghost">{{ section.settings.btn_ghost_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_scroll_hint -%}
      <div class="hero-scroll-hint" aria-hidden="true">
        <svg width="20" height="30" viewBox="0 0 20 30" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1" y="1" width="18" height="28" rx="9"/>
          <line x1="10" y1="8" x2="10" y2="14"/>
        </svg>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .hero-section { min-height: {{ section.settings.min_height }}vh; position: relative; }
  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ section.settings.text_align_desktop }};
    text-align: {{ section.settings.text_align_desktop | replace: 'flex-start', 'left' | replace: 'flex-end', 'right' | replace: 'center', 'center' }};
    padding: 80px 64px;
    min-height: {{ section.settings.min_height }}vh;
    position: relative;
    overflow: hidden;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
  }
  .hero-content { position: relative; z-index: 2; max-width: 680px; }
  .hero-eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    font-weight: 400;
    margin-bottom: 24px;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp({{ section.settings.heading_size_mobile }}px, 5vw, {{ section.settings.heading_size }}px);
    font-weight: 300;
    line-height: 1.05;
    color: {{ section.settings.heading_color }};
    margin-bottom: 28px;
    letter-spacing: -1px;
  }
  .hero-subtitle {
    font-size: 15px;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.8;
    margin: 0 auto 48px;
    letter-spacing: 0.3px;
    font-weight: 300;
    max-width: 520px;
  }
  .hero-cta-group { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .hero-scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    color: {{ section.settings.heading_color }};
    opacity: 0.5;
    animation: scrollHint 2s ease infinite;
  }
  @keyframes scrollHint { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(6px)} }
  @media (max-width: 768px) {
    .hero-right { padding: 60px 24px; align-items: center; text-align: center; }
    .hero-cta-group { justify-content: center; }
    .hero-subtitle { max-width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (no image)",
      "default": "#F2EDE5"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Overlay Color",
      "default": "#2A2520"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Height",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Text Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4A882"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A2520"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (Desktop)",
      "min": 40,
      "max": 120,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 28,
      "max": 72,
      "step": 4,
      "default": 52,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subheading Color",
      "default": "#6B5D52"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary Button Label"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_ghost_label",
      "label": "Ghost Button Label"
    },
    {
      "type": "url",
      "id": "btn_ghost_url",
      "label": "Ghost Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show Scroll Hint",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
