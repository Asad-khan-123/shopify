{%- liquid
  assign cols = section.settings.columns
  assign cols_mob = section.settings.columns_mobile
  assign collection_obj = collections[section.settings.collection]
-%}

<section class="featured-products" style="background: {{ section.settings.bg_color }};">
  <div class="featured-products__inner">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="products-grid featured-products__grid"
      style="--cols: {{ cols }}; --cols-mob: {{ cols_mob }};">

      {%- if collection_obj != blank and collection_obj.products.size > 0 -%}
        {%- for product in collection_obj.products limit: section.settings.products_to_show -%}
          {%- render 'card-product',
            card_product: product,
            show_quick_add: section.settings.show_quick_add,
            show_colors: section.settings.show_colors,
            section_id: section.id
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-card product-card--placeholder">
            <div class="product-image">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'product-placeholder-img' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-name">{{ 'onboarding.product_title' | t }}</h3>
              <p class="product-desc">{{ 'onboarding.product_type' | t }}</p>
              <div class="product-price"><span>{{ 1999 | money }}</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="section-cta">
        <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .featured-products { padding: var(--section-padding, 100px) 40px; }
  .featured-products__inner { max-width: var(--layout-max-width); margin: 0 auto; }
  .section-header { margin-bottom: 64px; text-align: center; }
  .featured-products__grid {
    grid-template-columns: repeat(var(--cols, 4), 1fr) !important;
  }
  .section-cta { text-align: center; margin-top: 48px; }
  @media (max-width: 768px) {
    .featured-products { padding: 60px 20px; }
    .featured-products__grid {
      grid-template-columns: repeat(var(--cols-mob, 2), 1fr) !important;
      gap: 16px 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_colors",
      "label": "Show Color Swatches",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFAF6"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
