<section class="collections-section" style="background: {{ section.settings.bg_color }};">
  <div class="collections-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collections-grid" style="--layout: {{ section.settings.layout }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' -%}
          {%- liquid
            assign col_obj = collections[block.settings.collection]
            assign card_img = block.settings.image | default: col_obj.image
          -%}
          <a href="{{ col_obj.url | default: '#' }}" class="collection-card {% if block.settings.tall %}tall{% endif %}"
            {{ block.shopify_attributes }}>
            <div class="collection-bg">
              {%- if card_img != blank -%}
                <img
                  src="{{ card_img | image_url: width: 800 }}"
                  alt="{{ card_img.alt | escape | default: col_obj.title | escape }}"
                  class="collection-bg-img"
                  width="800"
                  height="1066"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-placeholder-img' }}
              {%- endif -%}
            </div>
            <div class="collection-overlay">
              <h3 class="collection-name">{{ block.settings.title | default: col_obj.title }}</h3>
              {%- if block.settings.cta_label != blank -%}
                <span class="collection-cta">{{ block.settings.cta_label }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .collections-section { padding: var(--section-padding, 100px) 40px; }
  .collections-section__inner { max-width: var(--layout-max-width); margin: 0 auto; }
  .collections-grid {
    display: grid;
    grid-template-columns: var(--layout, 1.6fr 1fr 1fr);
    gap: 16px;
  }
  .collection-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 3/4;
    display: block;
    text-decoration: none;
  }
  .collection-card.tall { aspect-ratio: 2/3; }
  .collection-bg { width: 100%; height: 100%; }
  .collection-bg-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .collection-placeholder-img { width: 100%; height: 100%; }
  .collection-card:hover .collection-bg-img { transform: scale(1.05); }
  .collection-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30,22,15,0.65) 0%, transparent 55%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 36px 32px;
  }
  .collection-name {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.5vw, 38px);
    font-weight: 400;
    color: white;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .collection-cta {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.3s;
    font-weight: 400;
  }
  .collection-cta::after { content: '→'; transition: transform 0.3s; }
  .collection-card:hover .collection-cta { color: var(--accent-gold); }
  .collection-card:hover .collection-cta::after { transform: translateX(4px); }
  @media (max-width: 768px) {
    .collections-section { padding: 60px 20px; }
    .collections-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .collections-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid Layout",
      "options": [
        { "value": "1.6fr 1fr 1fr", "label": "Featured Left (3 col)" },
        { "value": "1fr 1fr", "label": "2 Columns" },
        { "value": "1fr 1fr 1fr", "label": "3 Columns Equal" },
        { "value": "1fr 1fr 1fr 1fr", "label": "4 Columns" }
      ],
      "default": "1.6fr 1fr 1fr"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2EDE5"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override Title"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA Label"
        },
        {
          "type": "checkbox",
          "id": "tall",
          "label": "Tall Card",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
