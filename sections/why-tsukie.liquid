<section class="why-tsukie" style="background: {{ section.settings.bg_color }};">
  <div class="why-tsukie__inner">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle" style="color: {{ section.settings.subheading_color }};">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pillars-grid" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <div class="pillar" {{ block.shopify_attributes }}>
            <span class="pillar-number" aria-hidden="true">0{{ forloop.index }}</span>
            {%- if block.settings.icon_svg != blank -%}
              <div class="pillar-icon">{{ block.settings.icon_svg }}</div>
            {%- elsif block.settings.icon_emoji != blank -%}
              <div class="pillar-icon-emoji">{{ block.settings.icon_emoji }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="pillar-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="pillar-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .why-tsukie {
    padding: 120px 40px;
    position: relative;
    overflow: hidden;
  }
  .why-tsukie::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(196,168,130,0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .why-tsukie::after {
    content: '';
    position: absolute;
    bottom: -40%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(196,168,130,0.05) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .why-tsukie__inner { max-width: var(--layout-max-width); margin: 0 auto; position: relative; z-index: 1; }
  .why-tsukie .section-header { margin-bottom: 80px; text-align: center; }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 32px;
  }
  .pillar {
    text-align: center;
    padding: 48px 40px;
    border: 1px solid rgba(196,168,130,0.3);
    position: relative;
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(8px);
    border-radius: 12px;
  }
  .pillar:hover {
    border-color: var(--accent-gold);
    background: rgba(196,168,130,0.08);
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .pillar-number {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 300;
    color: rgba(196,168,130,0.1);
    line-height: 1;
    position: absolute;
    top: 16px;
    right: 24px;
  }
  .pillar-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pillar-icon svg { width: 100%; height: 100%; stroke: var(--accent-gold); stroke-width: 1; fill: none; opacity: 0.9; }
  .pillar-icon-emoji { font-size: 40px; margin-bottom: 28px; }
  .pillar-title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    color: {{ section.settings.heading_color | default: '#F8F4EE' }};
    margin-bottom: 16px;
    letter-spacing: 0.5px;
  }
  .pillar-text {
    font-size: 14px;
    color: rgba(248,244,238,0.7);
    line-height: 1.8;
    letter-spacing: 0.2px;
  }
  @media (max-width: 1024px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .why-tsukie { padding: 80px 20px; }
    .pillars-grid { grid-template-columns: 1fr; }
    .pillar { padding: 36px 24px; }
  }
</style>

{% schema %}
{
  "name": "Why Us — Pillars",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4A882"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F8F4EE"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "rgba(248,244,238,0.65)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2A2520"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon (Emoji)"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon (SVG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Us — Pillars",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
