{%- liquid
  assign menu = linklists[section.settings.footer_menu_1]
  assign menu2 = linklists[section.settings.footer_menu_2]
  assign menu3 = linklists[section.settings.footer_menu_3]
-%}

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">

    {%- comment %} Brand Column {%- endcomment -%}
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="footer-logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" loading="lazy">
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="footer-tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="footer-desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- comment %} Social Icons {%- endcomment -%}
      <div class="footer-social" aria-label="{{ 'general.social.follow_on' | t }}">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_pinterest != blank -%}
          <a href="{{ section.settings.social_pinterest }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.181-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.806-2.428 1.808-2.428.853 0 1.267.641 1.267 1.408 0 .858-.546 2.140-.828 3.330-.236.995.499 1.806 1.476 1.806 1.771 0 3.135-1.867 3.135-4.563 0-2.386-1.715-4.053-4.163-4.053-2.833 0-4.497 2.125-4.497 4.322 0 .856.33 1.773.741 2.274.081.098.093.185.069.285-.075.313-.243.995-.276 1.134-.044.183-.146.222-.337.134-1.249-.581-2.030-2.407-2.030-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.220-5.190 6.220-1.013 0-1.966-.527-2.292-1.148l-.623 2.378c-.226.869-.835 1.958-1.244 2.621.937.29 1.931.446 2.962.446C17.523 22 22 17.523 22 12S17.523 2 12 2z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_youtube != blank -%}
          <a href="{{ section.settings.social_youtube }}" class="footer-social-link" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment %} Nav Column 1 {%- endcomment -%}
    {%- if menu.links.size > 0 -%}
      <div class="footer-nav">
        {%- if section.settings.footer_menu_1_title != blank -%}
          <h4 class="footer-nav-title">{{ section.settings.footer_menu_1_title }}</h4>
        {%- endif -%}
        <ul class="footer-nav-list" role="list">
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}" class="footer-nav-link">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment %} Nav Column 2 {%- endcomment -%}
    {%- if menu2.links.size > 0 -%}
      <div class="footer-nav">
        {%- if section.settings.footer_menu_2_title != blank -%}
          <h4 class="footer-nav-title">{{ section.settings.footer_menu_2_title }}</h4>
        {%- endif -%}
        <ul class="footer-nav-list" role="list">
          {%- for link in menu2.links -%}
            <li><a href="{{ link.url }}" class="footer-nav-link">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment %} Nav Column 3 {%- endcomment -%}
    {%- if menu3.links.size > 0 -%}
      <div class="footer-nav">
        {%- if section.settings.footer_menu_3_title != blank -%}
          <h4 class="footer-nav-title">{{ section.settings.footer_menu_3_title }}</h4>
        {%- endif -%}
        <ul class="footer-nav-list" role="list">
          {%- for link in menu3.links -%}
            <li><a href="{{ link.url }}" class="footer-nav-link">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment %} Newsletter {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="footer-newsletter">
        {%- if section.settings.newsletter_title != blank -%}
          <h4 class="footer-nav-title">{{ section.settings.newsletter_title }}</h4>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p class="footer-newsletter-text">{{ section.settings.newsletter_text }}</p>
        {%- endif -%}
        {%- form 'customer', id: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-newsletter-input-group">
            <input
              type="email"
              name="contact[email]"
              id="footer-newsletter-email"
              class="footer-newsletter-input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'your@email.com' }}"
              required
              autocomplete="email"
              aria-label="{{ section.settings.newsletter_placeholder | default: 'Email address' }}"
            >
            <button type="submit" class="footer-newsletter-btn" aria-label="{{ section.settings.newsletter_btn_label | default: 'Subscribe' }}">
              {{ section.settings.newsletter_btn_label | default: '→' }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="footer-newsletter-success">{{ 'general.newsletter_form.confirmation' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text }}
        {%- endif -%}
      </p>
      {%- if section.settings.payment_icons -%}
        <div class="footer-payment" aria-label="{{ 'sections.footer.payment' | t }}">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'footer-payment-icon' }}
          {% endfor %}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: {{ section.settings.footer_bg }};
    color: {{ section.settings.footer_text }};
    padding-top: 80px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1.5fr;
    gap: 48px;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 40px 60px;
  }
  .footer-logo {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    display: block;
    margin-bottom: 20px;
  }
  .footer-logo img { max-width: 160px; }
  .footer-tagline {
    font-family: var(--font-serif);
    font-size: 16px;
    font-style: italic;
    margin-bottom: 12px;
    opacity: 0.8;
  }
  .footer-desc {
    font-size: 13px;
    line-height: 1.8;
    opacity: 0.65;
    margin-bottom: 28px;
  }
  .footer-social { display: flex; gap: 16px; align-items: center; }
  .footer-social-link {
    color: inherit;
    opacity: 0.65;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
  }
  .footer-social-link:hover { opacity: 1; }
  .footer-nav-title {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 20px;
    opacity: 0.5;
  }
  .footer-nav-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .footer-nav-link {
    font-size: 13px;
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s;
    letter-spacing: 0.5px;
  }
  .footer-nav-link:hover { opacity: 1; }
  .footer-newsletter-text { font-size: 13px; opacity: 0.65; line-height: 1.7; margin-bottom: 16px; }
  .footer-newsletter-input-group { display: flex; border: 1px solid rgba(255,255,255,0.2); }
  .footer-newsletter-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 12px 14px;
    font-size: 12px;
    color: inherit;
    outline: none;
    font-family: var(--font-sans);
  }
  .footer-newsletter-input::placeholder { opacity: 0.5; }
  .footer-newsletter-btn {
    background: var(--accent-gold);
    color: var(--charcoal);
    border: none;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s;
  }
  .footer-newsletter-btn:hover { background: var(--nude); }
  .footer-newsletter-success { font-size: 12px; color: var(--accent-gold); margin-top: 10px; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 20px 40px;
  }
  .footer-bottom-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .footer-copyright { font-size: 11px; letter-spacing: 1px; opacity: 0.5; }
  .footer-payment { display: flex; gap: 8px; align-items: center; }
  .footer-payment-icon { height: 24px; opacity: 0.6; }
  @media (max-width: 1024px) {
    .footer-inner { grid-template-columns: 1fr 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr 1fr; padding: 0 20px 48px; gap: 36px; }
    .footer-bottom { padding: 20px; }
    .footer-bottom-inner { flex-direction: column; text-align: center; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo (optional)"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand Description"
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Menu 1",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "footer_menu_1_title",
      "label": "Menu 1 Heading"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Menu 2"
    },
    {
      "type": "text",
      "id": "footer_menu_2_title",
      "label": "Menu 2 Heading"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Menu 3"
    },
    {
      "type": "text",
      "id": "footer_menu_3_title",
      "label": "Menu 3 Heading"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Heading"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Description"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input Placeholder"
    },
    {
      "type": "text",
      "id": "newsletter_btn_label",
      "label": "Button Label"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text"
    },
    {
      "type": "checkbox",
      "id": "payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Background Color",
      "default": "#2A2520"
    },
    {
      "type": "color",
      "id": "footer_text",
      "label": "Text Color",
      "default": "#F8F4EE"
    }
  ]
}
{% endschema %}
