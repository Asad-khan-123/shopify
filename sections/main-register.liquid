<div class="customer-section">
  <div class="customer-inner">
    {%- render 'breadcrumb' -%}
    <h1 class="customer-page-title">{{ section.settings.heading | default: 'customer.register.title' | t }}</h1>
    <p class="customer-page-sub">{{ section.settings.subtext }}</p>

    {%- form 'create_customer', id: 'create_customer', class: 'customer-form' -%}
      {%- if form.errors -%}
        <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact-form-row">
        <div class="form-field">
          <label class="form-label" for="RegisterFirstName">{{ section.settings.first_name_label | default: 'customer.register.first_name' | t }}</label>
          <input type="text" name="customer[first_name]" id="RegisterFirstName" class="form-input" autocomplete="given-name" placeholder="{{ section.settings.first_name_placeholder }}">
        </div>
        <div class="form-field">
          <label class="form-label" for="RegisterLastName">{{ section.settings.last_name_label | default: 'customer.register.last_name' | t }}</label>
          <input type="text" name="customer[last_name]" id="RegisterLastName" class="form-input" autocomplete="family-name" placeholder="{{ section.settings.last_name_placeholder }}">
        </div>
      </div>
      <div class="form-field">
        <label class="form-label" for="RegisterEmail">{{ section.settings.email_label | default: 'customer.register.email' | t }}</label>
        <input type="email" name="customer[email]" id="RegisterEmail" class="form-input" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ section.settings.email_placeholder }}" required>
      </div>
      <div class="form-field">
        <label class="form-label" for="RegisterPassword">{{ section.settings.password_label | default: 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="RegisterPassword" class="form-input" autocomplete="new-password" placeholder="{{ section.settings.password_placeholder }}" required>
      </div>
      <button type="submit" class="btn-primary">{{ section.settings.submit_label | default: 'customer.register.submit' | t }}</button>
      <p class="customer-register-link">
        {{ section.settings.login_text }}
        <a href="{{ routes.account_login_url }}">{{ section.settings.login_link | default: 'customer.register.login_link' | t }}</a>
      </p>
    {%- endform -%}
  </div>
</div>

<style>
  .contact-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .customer-register-link { font-size: 13px; color: var(--muted-brown); margin-top: 20px; text-align: center; }
  .customer-register-link a { color: var(--accent-rust); text-decoration: underline; text-underline-offset: 3px; }
  .customer-form .btn-primary { margin-top: 8px; width: 100%; }
  @media (max-width: 480px) { .contact-form-row { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Register",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "first_name_label", "label": "First Name Label" },
    { "type": "text", "id": "first_name_placeholder", "label": "First Name Placeholder" },
    { "type": "text", "id": "last_name_label", "label": "Last Name Label" },
    { "type": "text", "id": "last_name_placeholder", "label": "Last Name Placeholder" },
    { "type": "text", "id": "email_label", "label": "Email Label" },
    { "type": "text", "id": "email_placeholder", "label": "Email Placeholder" },
    { "type": "text", "id": "password_label", "label": "Password Label" },
    { "type": "text", "id": "password_placeholder", "label": "Password Placeholder" },
    { "type": "text", "id": "submit_label", "label": "Submit Label" },
    { "type": "text", "id": "login_text", "label": "Login Text" },
    { "type": "text", "id": "login_link", "label": "Login Link Text" }
  ]
}
{% endschema %}
