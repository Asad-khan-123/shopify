<section class="newsletter-section" style="background: {{ section.settings.bg_color }};">
  <div class="newsletter-inner">
    {%- if section.settings.image != blank -%}
      <div class="newsletter-media">
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          class="newsletter-img"
          width="800"
          height="600"
          loading="lazy"
        >
      </div>
    {%- endif -%}

    <div class="newsletter-content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-title" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="newsletter-text" style="color: {{ section.settings.text_color }};">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'newsletter-form-{{ section.id }}' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form-group">
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email-{{ section.id }}"
            class="newsletter-input"
            placeholder="{{ section.settings.placeholder }}"
            required
            autocomplete="email"
            aria-label="{{ section.settings.placeholder | default: 'Email address' }}"
          >
          <button type="submit" class="newsletter-btn" style="background: {{ section.settings.btn_color }}; color: {{ section.settings.btn_text_color }};">
            {{ section.settings.btn_label }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="newsletter-success" role="status">{{ section.settings.success_text }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="newsletter-error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="newsletter-disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .newsletter-section { padding: var(--section-padding, 100px) 40px; }
  .newsletter-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: {% if section.settings.image != blank %}1fr 1fr{% else %}1fr{% endif %};
    gap: 60px;
    align-items: center;
  }
  .newsletter-media { border-radius: 4px; overflow: hidden; }
  .newsletter-img { width: 100%; height: 100%; object-fit: cover; }
  .newsletter-content { text-align: {% if section.settings.image != blank %}left{% else %}center{% endif %}; }
  .newsletter-title { font-family: var(--font-serif); font-size: clamp(32px, 4vw, 52px); font-weight: 300; margin-bottom: 16px; line-height: 1.1; }
  .newsletter-text { font-size: 15px; line-height: 1.8; opacity: 0.75; margin-bottom: 32px; }
  .newsletter-form-group { display: flex; border: 1px solid {{ section.settings.border_color }}; max-width: 440px; {% unless section.settings.image != blank %}margin: 0 auto;{% endunless %} }
  .newsletter-input { flex: 1; background: transparent; border: none; padding: 14px 16px; font-size: 13px; color: {{ section.settings.heading_color }}; font-family: var(--font-sans); outline: none; }
  .newsletter-input::placeholder { opacity: 0.5; }
  .newsletter-btn { padding: 14px 24px; font-family: var(--font-sans); font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; cursor: pointer; border: none; white-space: nowrap; transition: opacity 0.2s; }
  .newsletter-btn:hover { opacity: 0.85; }
  .newsletter-success { font-size: 13px; color: var(--accent-gold); margin-top: 12px; }
  .newsletter-error { font-size: 13px; color: var(--accent-rust); margin-top: 12px; }
  .newsletter-disclaimer { font-size: 11px; opacity: 0.45; margin-top: 16px; letter-spacing: 0.3px; }
  @media (max-width: 768px) {
    .newsletter-section { padding: 60px 20px; }
    .newsletter-inner { grid-template-columns: 1fr; gap: 32px; }
    .newsletter-content { text-align: center; }
    .newsletter-form-group { margin: 0 auto; }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4A882"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A2520"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6B5D52"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Color",
      "default": "#2A2520"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#F8F4EE"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Input Border Color",
      "default": "#E8DFD2"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success Message"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2EDE5"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
