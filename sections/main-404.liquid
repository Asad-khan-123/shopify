<div class="error-page">
  <div class="error-page__inner">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 600 }}"
        alt="{{ section.settings.image.alt | escape }}"
        class="error-page__img"
        width="600"
        height="400"
        loading="eager"
      >
    {%- endif -%}

    <p class="error-page__code">{{ section.settings.error_code | default: '404' }}</p>
    <h1 class="error-page__title">{{ section.settings.heading }}</h1>
    <p class="error-page__text">{{ section.settings.subheading }}</p>

    <div class="error-page__actions">
      {%- if section.settings.btn_primary_label != blank -%}
        <a href="{{ section.settings.btn_primary_url | default: routes.root_url }}" class="btn-primary">
          {{ section.settings.btn_primary_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_secondary_label != blank -%}
        <a href="{{ section.settings.btn_secondary_url | default: routes.collections_url }}" class="btn-ghost">
          {{ section.settings.btn_secondary_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_search -%}
      <div class="error-page__search">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <div class="error-search-group">
            <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" class="error-search-input" aria-label="{{ section.settings.search_placeholder }}">
            <button type="submit" class="error-search-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </button>
          </div>
        </form>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .error-page { min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 80px 40px; text-align: center; }
  .error-page__inner { max-width: 600px; }
  .error-page__img { max-width: 300px; margin: 0 auto 32px; display: block; opacity: 0.7; }
  .error-page__code { font-family: var(--font-serif); font-size: 120px; font-weight: 300; color: var(--sand); line-height: 1; margin-bottom: 16px; }
  .error-page__title { font-family: var(--font-serif); font-size: clamp(28px, 4vw, 48px); font-weight: 300; color: var(--charcoal); margin-bottom: 16px; }
  .error-page__text { font-size: 15px; color: var(--muted-brown); line-height: 1.8; margin-bottom: 40px; }
  .error-page__actions { display: flex; gap: 16px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .error-page__search { max-width: 400px; margin: 0 auto; }
  .error-search-group { display: flex; border: 1px solid var(--sand); }
  .error-search-input { flex: 1; background: transparent; border: none; padding: 12px 16px; font-size: 13px; font-family: var(--font-sans); color: var(--charcoal); outline: none; }
  .error-search-btn { background: var(--charcoal); border: none; padding: 12px 16px; cursor: pointer; color: var(--cream); display: flex; align-items: center; }
</style>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Illustration Image"
    },
    {
      "type": "text",
      "id": "error_code",
      "label": "Error Code"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary Button Label"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder"
    }
  ],
  "presets": [
    {
      "name": "404 Page"
    }
  ]
}
{% endschema %}
