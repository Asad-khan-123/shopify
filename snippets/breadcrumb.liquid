<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
  <span aria-hidden="true">&#47;</span>
  {%- if template.name == 'product' -%}
    {%- if collection != blank -%}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span aria-hidden="true">&#47;</span>
    {%- endif -%}
    <span>{{ product.title | escape }}</span>
  {%- elsif template.name == 'collection' -%}
    <span>{{ collection.title | escape }}</span>
  {%- elsif template.name == 'page' -%}
    <span>{{ page.title | escape }}</span>
  {%- elsif template.name == 'blog' -%}
    <span>{{ blog.title | escape }}</span>
  {%- elsif template.name == 'article' -%}
    <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
    <span aria-hidden="true">&#47;</span>
    <span>{{ article.title | escape }}</span>
  {%- elsif template.name == 'cart' -%}
    <span>{{ 'sections.cart.title' | t }}</span>
  {%- elsif template.name == 'search' -%}
    <span>{{ 'general.search.title' | t }}</span>
  {%- endif -%}
</nav>
